<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.skipintro" name="Skip Intro" version="1.4.7" provider-name="wabisabi926">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" start="login"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">Skip intro and credits for TV shows</summary>
        <summary lang="zh">跳过电视剧片头片尾</summary>
        <description lang="en">Automatically skip the intro and closing credits of TV shows.
             Mark the intro end point once per season; a single episode can be marked separately.
             Markers already synced by Emby for Kodi are used automatically.
             Bind the record/delete actions to a key in your keymap to mark timestamps during playback.
         </description>
         <description lang="zh">自动跳过电视剧的片头和片尾。
             每季标记一次即可全季生效，个别集可以单独标记。
             Emby for Kodi 已同步的片头片尾标记会自动使用。
             在按键映射里绑定记录/删除动作，即可在播放中标记时间点。
         </description>
        <disclaimer lang="en">For personal use only</disclaimer>
        <disclaimer lang="zh">仅供个人使用</disclaimer>
        <platform>all</platform>
        <license>Creative Commons Non Commercial 3.0 License</license>
        <source>https://github.com/wabisabi926/plugin.video.skipintro</source>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>