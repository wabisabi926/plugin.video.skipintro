#: service.py
msgctxt "#32000"
msgid "Intro Skipped - Now playing S%02dE%02d"
msgstr "已跳过片头 - 正在播放 S%02dE%02d"

#: service.py
msgctxt "#32001"
msgid "About to finish playing"
msgstr "即将播放完 S%02dE%02d"

#: service.py
msgctxt "#32002"
msgid "Play next episode cancelled"
msgstr "下一集播放已取消"

#: service.py
msgctxt "#32003"
msgid "Playing next episode... Press \"Back\" within %d seconds to cancel"
msgstr "即将播放下一集... %d 秒内按\"返回键\"可取消"

#: default.py
msgctxt "#32004"
msgid "Skip not available for non-episodes"
msgstr "跳过不适用于非剧集"

#: default.py
msgctxt "#32005"
msgid "Intro recorded: %02d:%02d"
msgstr "已记录片头: %02d:%02d"

#: default.py
msgctxt "#32006"
msgid "Outro duration recorded: %02d:%02d"
msgstr "已记录片尾时长: %02d:%02d"

#: default.py
msgctxt "#32007"
msgid "Please call within first or last 20% of the episode"
msgstr "请在剧集前或后 20% 时间段内调用"

#: default.py
msgctxt "#32008"
msgid "%s (Season %s)"
msgstr "%s (第 %s 季)"

#: default.py
msgctxt "#32009"
msgid "Recording failed, please check logs"
msgstr "记录失败，请查看日志"

#: default.py
msgctxt "#32010"
msgid "No intro/outro markers"
msgstr "无片头片尾记录点"

#: default.py
msgctxt "#32011"
msgid "Intro record deleted"
msgstr "已删除片头记录"

#: default.py
msgctxt "#32012"
msgid "No intro record"
msgstr "当前无片头记录"

#: default.py
msgctxt "#32013"
msgid "Outro record deleted"
msgstr "已删除片尾记录"

#: default.py
msgctxt "#32014"
msgid "No outro record"
msgstr "当前无片尾记录"

#: default.py
msgctxt "#32015"
msgid "Delete failed!Please call within first or last 20% of the episode"
msgstr "删除失败，请在剧集前或后 20% 时间段内调用"

#: default.py
msgctxt "#32016"
msgid "Delete error"
msgstr "删除错误"

#: settings.xml
msgctxt "#32017"
msgid "Auto fill playlist on play"
msgstr "播放时自动补全播放列表"

#: settings.xml
msgctxt "#32018"
msgid "Automatically fill the playlist with episodes from the same season when playing a TV show episode."
msgstr "播放电视剧集时自动将同季剧集添加到播放列表中"

#: settings.xml
msgctxt "#32019"
msgid "Playlist Settings"
msgstr "播放列表设置"

#: default.py
msgctxt "#32025"
msgid "OK"
msgstr "确定"

#: default.py
msgctxt "#32026"
msgid "Cancel"
msgstr "取消"

#: default.py, service.py
msgctxt "#32027"
msgid "Skip Intro"
msgstr "跳过片头片尾"

#: settings.xml
msgctxt "#32028"
msgid "Enable debug logging"
msgstr "启用调试日志"

#: settings.xml
msgctxt "#32029"
msgid "Enable detailed debug logging for troubleshooting."
msgstr "启用详细的调试日志记录，用于故障排除。"

#: settings.xml
msgctxt "#32030"
msgid "General"
msgstr "常规"

#: settings.xml
msgctxt "#32031"
msgid "Logging"
msgstr "日志"

#: service.py
msgctxt "#32032"
msgid "No more episodes available"
msgstr "已播放完最后一集"

#: settings.xml
msgctxt "#32033"
msgid "Delete all skip points"
msgstr "删除所有记录点"

#: default.py
msgctxt "#32034"
msgid "Are you sure you want to delete all skip points? This action cannot be undone."
msgstr "确定要删除所有记录点吗？此操作不可撤销。"

#: default.py
msgctxt "#32035"
msgid "All skip points deleted"
msgstr "已删除所有记录点"
